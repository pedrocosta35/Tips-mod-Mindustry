#the mod name as displayed in-game
displayName: "Waves Tips Mod"

#the internal name of your mod
name: "waves-tips-mod"

#your name
author: "Pedro Costa 68601 / Rodrigo Moreira 68370"

#the fully qualified main class of the mod
main: "tipsMod.JavaWavesTipsMod"

#the mod description as seen in the mod dialog
description: "A Mindustry Java mod that gives tips about the enemies waves."

#the mod version
version: 1.0

#the minimum game build required to run this mod
minGameVersion: 150

#this is a java mod
java: true
